{
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "docker compose up",
    "shell": "pnpm container:shell",
    "container:install": "docker compose exec -it unbgeology-lib-unb-ca pnpm add",
    "container:inspect": "docker compose exec -it unbgeology-lib-unb-ca pnpm list",
    "container:postinstall": "docker compose exec -it unbgeology-lib-unb-ca pnpm postinstall",
    "container:shell": "docker compose exec -it unbgeology-lib-unb-ca /bin/bash",
    "lint": "eslint .",
    "lint:inspect": "npx @eslint/config-inspector@latest",
    "lint:staged": "eslint $(find $(git diff --diff-filter=d --name-only --cached | xargs) -type f -name \"*.ts\") --no-error-on-unmatched-pattern --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run -c ./tests/unit/vitest.config.ts",
    "test:e2e": "cypress open -C ./tests/e2e/cypress.config.ts",
    "test:e2e:headless": "cypress run -C ./tests/e2e/cypress.config.ts"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@nuxt/eslint-config": "^0.5.7",
    "cross-fetch": "^4.0.0",
    "cypress": "^12.9.0",
    "eslint": "^9.10.0",
    "eslint-plugin-tailwindcss": "^3.11.0",
    "vitest": "^0.29.8",
    "@tailwindcss/forms": "^0.5.0",
    "@types/doi-regex": "^0.1.3",
    "@types/formidable": "^3.4.4",
    "@types/leaflet": "^1.9.3",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/lodash": "^4.14.194",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.23",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.3.1",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "@fast-csv/parse": "^5.0.0",
    "@node-saml/node-saml": "^4.0.0",
    "@nuxt/image": "^1.0.0",
    "@nuxtjs/robots": "^6.0.8",
    "@nuxtjs/sitemap": "^8.0.15",
    "@unb-libraries/nuxt-layer-entity": "./layers/entity",
    "@vueuse/router": "^14.0.0-alpha.0",
    "casbin": "^5.29.0",
    "doi-regex": "^0.1.13",
    "h3-formidable": "^0.3.8",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "leaflet.markercluster": "^1.5.3",
    "lightship": "^9.0.0",
    "nuxt": "^4.4.4",
    "mongoose": "^8.23.1",
    "primevue": "^3.0.0",
    "slugify": "^1.6.6",
    "vee-validate": "^4.0.0",
    "zod": "^3.23.8"
  }
}
