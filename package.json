{
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "docker compose up",
    "shell": "pnpm container:shell",
    "container:install": "docker compose exec -it unbgeology-lib-unb-ca pnpm add",
    "container:inspect": "docker compose exec -it unbgeology-lib-unb-ca pnpm list",
    "container:postinstall": "docker compose exec -it unbgeology-lib-unb-ca pnpm postinstall",
    "container:shell": "docker compose exec -it unbgeology-lib-unb-ca /bin/bash",
    "lint": "eslint .",
    "lint:inspect": "npx @eslint/config-inspector@latest",
    "lint:staged": "eslint $(find $(git diff --diff-filter=d --name-only --cached | xargs) -type f -name \"*.ts\") --no-error-on-unmatched-pattern --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run -c ./tests/unit/vitest.config.ts",
    "test:e2e": "cypress open -C ./tests/e2e/cypress.config.ts",
    "test:e2e:headless": "cypress run -C ./tests/e2e/cypress.config.ts"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^0.5.7",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/doi-regex": "^0.1.3",
    "@types/formidable": "^3.5.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/lodash": "^4.17.24",
    "autoprefixer": "^10.5.4",
    "cross-fetch": "^4.1.0",
    "cypress": "^12.17.4",
    "eslint": "^9.39.5",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "postcss": "^8.5.23",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^0.29.8"
  },
  "dependencies": {
    "@fast-csv/parse": "^5.0.7",
    "@node-saml/node-saml": "^5.1.0",
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/robots": "^6.1.3",
    "@nuxtjs/sitemap": "^8.3.0",
    "@unb-libraries/nuxt-layer-entity": "link:layers/entity",
    "@vueuse/router": "^14.3.0",
    "casbin": "^5.51.1",
    "doi-regex": "^0.1.17",
    "h3-formidable": "^0.3.8",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "leaflet.markercluster": "^1.5.3",
    "lightship": "^9.0.4",
    "mongoose": "^8.24.1",
    "nuxt": "^4.5.1",
    "nuxt-auth-utils": "^0.5.29",
    "primevue": "^3.53.1",
    "slugify": "^1.6.9",
    "vee-validate": "^4.15.1",
    "zod": "^3.25.76"
  }
}
